# ══════════════════════════════════════════════════════════════════════════════
# Single Environment Configuration for Modernize Portfolio
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme
MONGO_PORT=27017
MONGO_URI=mongodb://admin:changeme@localhost:27017/portfolio?authSource=admin

# ──────────────────────────────────────────────
# Mongo Express (dev profile only)
# ──────────────────────────────────────────────
ME_PORT=8081
ME_USER=admin
ME_PASS=admin

# ──────────────────────────────────────────────
# Backend App
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_PORT=5000
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5001,http://localhost:80
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Storage Provider
# ──────────────────────────────────────────────
# Options: 'minio' (local dev), 'cloudinary' (production)
STORAGE_PROVIDER=minio

# ──────────────────────────────────────────────
# MinIO (dev profile only)
# ──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=portfolio
MINIO_USE_SSL=false

# ──────────────────────────────────────────────
# Cloudinary (production)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────────────
# Google OAuth
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id
ADMIN_EMAIL=your_email@example.com

# ──────────────────────────────────────────────
# AI Copilot (Gemini)
# ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.5-flash
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_REQUEST_LIMIT=30
RAG_MAX_RESULTS=5

# ──────────────────────────────────────────────
# SMTP / Brevo (for admin reply emails)
# ──────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM_NAME=Portfolio
SMTP_FROM_EMAIL=your_email@example.com

# ──────────────────────────────────────────────
# Frontend (Vite) - 3D Experience Scene
# ──────────────────────────────────────────────
# External GLB/GLTF model URL (optional)
# If set, loads a student-at-computer 3D model from this URL.
# If unset or loading fails, a procedural fallback scene is displayed.
VITE_EXPERIENCE_3D_MODEL_URL=

# ──────────────────────────────────────────────
# Nginx (prod profile only)
# ──────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443