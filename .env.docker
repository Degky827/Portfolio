# ══════════════════════════════════════════════════════════════════════════════
# Docker Compose Environment Variables
# Copy this to .env in the project root and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme
MONGO_PORT=27017

# ──────────────────────────────────────────────
# Mongo Express (dev profile only)
# ──────────────────────────────────────────────
ME_PORT=8081
ME_USER=admin
ME_PASS=admin

# ──────────────────────────────────────────────
# Backend App
# ──────────────────────────────────────────────
APP_PORT=5000
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80
FRONTEND_URL=http://localhost

# ──────────────────────────────────────────────
# Storage Provider
# ──────────────────────────────────────────────
# Options: 'minio' (local dev), 'cloudinary' (production)
STORAGE_PROVIDER=minio

# ──────────────────────────────────────────────
# MinIO (dev profile only)
# ──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=portfolio
MINIO_USE_SSL=false

# ──────────────────────────────────────────────
# Google OAuth (optional)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_EMAIL=your_email@example.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# ──────────────────────────────────────────────
# Cloudinary (production)
# ──────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────────────
# AI Copilot (optional)
# ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.5-flash
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_REQUEST_LIMIT=30
RAG_MAX_RESULTS=5

# ──────────────────────────────────────────────
# Nginx (prod profile only)
# ──────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
