# ══════════════════════════════════════════════════════════════
# Portkiro Frontend — Environment Variables
# ══════════════════════════════════════════════════════════════
# All VITE_* vars are embedded at build time by Vite.
# Copy this file to a local .env file (gitignored) or set in your hosting dashboard.
# ══════════════════════════════════════════════════════════════

# Backend API URL (defaults to http://localhost:5000/api)
# VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID — Sign In with Google
# Create a credential in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web Client
# VITE_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# EmailJS Credentials (optional — Contact form falls back to mailto: link if missing)
# Get these for free at https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# 3D Experience Scene — External GLB/GLTF model URL (optional)
# If set, loads a student-at-computer 3D model from this URL.
# If unset or loading fails, a procedural fallback scene is displayed.
# VITE_EXPERIENCE_3D_MODEL_URL=https://example.com/models/student-at-desk.glb
